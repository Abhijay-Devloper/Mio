# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional: Firebase Realtime Database URL when not auto-populated in google-services.json
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Backend WebRTC TURN Service:
# TURN credentials and Metered keys are securely managed on the backend (Firebase Cloud Functions).
# No third-party API keys or credentials are stored or compiled into this Android APK.
# Optional override for the backend Cloud Function / Vercel TURN URL:
# BACKEND_TURN_FUNCTION_URL=https://your-vercel-app.vercel.app/api/turn

# Backend Push Notification Relay (for Firebase Spark plan / Vercel):
# Point this to your deployed /api/notify endpoint so Mio triggers high-priority FCM pushes
# for new messages and incoming calls even when the recipient's screen is off or app is closed.
# BACKEND_PUSH_URL=https://your-vercel-app.vercel.app/api/notify
